{env.DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	# database manager and the RPC "db" service are local-only (127.0.0.1:8069)
	@dbmanager {
		path /web/database/* /xmlrpc/db /xmlrpc/2/db
		not path /web/database/selector
	}
	respond @dbmanager 404

	reverse_proxy odoo:8069
}
