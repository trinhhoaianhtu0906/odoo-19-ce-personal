<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_vn_stock_ledger_sync" model="ir.cron">
        <field name="name">Stock Movement Summary: update the daily stock ledger</field>
        <field name="model_id" ref="model_vn_stock_ledger"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
