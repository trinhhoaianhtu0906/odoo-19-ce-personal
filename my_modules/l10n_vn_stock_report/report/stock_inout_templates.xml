<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_vn_stock_a4_landscape" model="report.paperformat">
        <field name="name">A4 Landscape - Stock Movement Summary</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_vn_stock_inout" model="ir.actions.report">
        <field name="name">Stock Movement Summary</field>
        <field name="model">vn.stock.inout.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_vn_stock_report.report_vn_stock_inout</field>
        <field name="report_file">l10n_vn_stock_report.report_vn_stock_inout</field>
        <field name="print_report_name">object._export_filename()</field>
        <field name="paperformat_id" ref="paperformat_vn_stock_a4_landscape"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vn_stock_inout">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id"/>
                <t t-set="columns" t-value="doc.amount_columns()"/>
                <t t-set="totals" t-value="doc.totals()"/>
                <t t-set="cell" t-value="'border: 1px solid #000; padding: 2px 4px;'"/>
                <div class="article o_vn_stock_inout" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
                     style="font-family: 'Times New Roman', serif; font-size: 11px;">
                    <div><b>Company:</b> <span t-field="company.name"/></div>
                    <div><b>Address:</b>
                        <span t-esc="', '.join(filter(None, [company.street, company.street2, company.city, company.state_id.name]))"/>
                    </div>
                    <div style="text-align: center; margin-top: 12px;">
                        <div style="font-size: 16px; font-weight: bold;">STOCK MOVEMENT SUMMARY</div>
                        <div style="font-style: italic;" t-esc="doc.period_text()"/>
                        <div style="font-style: italic;" t-esc="doc.scope_text()"/>
                    </div>
                    <div style="text-align: right; font-style: italic; margin: 6px 0;">
                        Currency: <span t-esc="company.currency_id.name"/>
                    </div>
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="text-align: center; font-weight: bold;">
                                <th rowspan="2" t-att-style="cell + 'width: 3%;'">No.</th>
                                <th rowspan="2" t-att-style="cell + 'width: 8%;'">Code</th>
                                <th rowspan="2" t-att-style="cell">Product</th>
                                <th rowspan="2" t-att-style="cell + 'width: 4%;'">UoM</th>
                                <t t-foreach="doc.column_groups()" t-as="group">
                                    <th t-att-colspan="group[1]" t-att-style="cell" t-esc="group[0]"/>
                                </t>
                            </tr>
                            <tr style="text-align: center; font-weight: bold;">
                                <th t-foreach="columns" t-as="column" t-att-style="cell + 'width: 7%;'"
                                    t-esc="doc.column_label(column[1])"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.line_ids" t-as="line" style="page-break-inside: avoid;">
                                <td t-att-style="cell + 'text-align: center;'" t-esc="line.sequence"/>
                                <td t-att-style="cell" t-esc="line.default_code or ''"/>
                                <td t-att-style="cell" t-esc="line.product_name"/>
                                <td t-att-style="cell + 'text-align: center;'" t-esc="line.uom_id.name"/>
                                <td t-foreach="columns" t-as="column" t-att-style="cell + 'text-align: right; white-space: nowrap;'"
                                    t-esc="doc.format_cell(line[column[0]], column[1])"/>
                            </tr>
                            <tr style="font-weight: bold;">
                                <td colspan="4" t-att-style="cell + 'text-align: center;'">Total</td>
                                <td t-foreach="columns" t-as="column" t-att-style="cell + 'text-align: right; white-space: nowrap;'"
                                    t-esc="doc.format_cell(totals[column[0]], 'value') if column[1] == 'value' else ''"/>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width: 100%; margin-top: 24px; text-align: center; page-break-inside: avoid;">
                        <tr>
                            <td style="width: 33%;"><b>Prepared by</b><div style="font-style: italic;">(Signature, full name)</div></td>
                            <td style="width: 33%;"><b>Chief Accountant</b><div style="font-style: italic;">(Signature, full name)</div></td>
                            <td style="width: 34%;"><b>Legal Representative</b><div style="font-style: italic;">(Signature, full name, seal)</div></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
