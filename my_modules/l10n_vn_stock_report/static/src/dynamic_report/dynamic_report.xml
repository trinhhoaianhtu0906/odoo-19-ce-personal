<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_vn_stock_report.DynamicReport">
        <div class="o_action o_vn_stock_report h-100 d-flex flex-column">
            <div class="o_control_panel border-bottom px-3 py-2 bg-view" t-if="state.choices">
                <div class="d-flex flex-wrap align-items-end gap-3">
                    <div t-if="state.choices.companies.length &gt; 1">
                        <label class="form-label small text-muted mb-0">Company</label>
                        <select class="form-select form-select-sm" t-on-change="onCompanyChange">
                            <t t-foreach="state.choices.companies" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="c.id === state.options.company_id" t-esc="c.name"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-0">Warehouse</label>
                        <select class="form-select form-select-sm" t-on-change="onWarehouseChange">
                            <option value="" t-att-selected="!state.options.warehouse_id">All Warehouses</option>
                            <t t-foreach="warehouses" t-as="w" t-key="w.id">
                                <option t-att-value="w.id" t-att-selected="w.id === state.options.warehouse_id" t-esc="w.name"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-0">Year</label>
                        <select class="form-select form-select-sm" t-on-change="onYearChange">
                            <t t-foreach="years" t-as="y" t-key="y">
                                <option t-att-value="y" t-att-selected="y === state.year" t-esc="y"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-0">Period</label>
                        <select class="form-select form-select-sm" t-on-change="onPeriodChange">
                            <t t-foreach="periods" t-as="p" t-key="p.key">
                                <option t-att-value="p.key" t-att-selected="p.key === state.period" t-esc="p.label"/>
                            </t>
                        </select>
                    </div>
                    <t t-if="state.period === 'custom'">
                        <div>
                            <label class="form-label small text-muted mb-0">Date From</label>
                            <input type="date" class="form-control form-control-sm" t-att-value="state.options.date_from"
                                   t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                        </div>
                        <div>
                            <label class="form-label small text-muted mb-0">Date To</label>
                            <input type="date" class="form-control form-control-sm" t-att-value="state.options.date_to"
                                   t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                        </div>
                    </t>
                    <div>
                        <label class="form-label small text-muted mb-0">Product Category</label>
                        <select class="form-select form-select-sm" t-on-change="onCategoryChange">
                            <option value="" t-att-selected="!state.options.categ_ids.length">All Categories</option>
                            <t t-foreach="state.choices.categories" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="state.options.categ_ids.includes(c.id)" t-esc="c.name"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-0">Search</label>
                        <input type="search" class="form-control form-control-sm" placeholder="Code or product name..."
                               t-att-value="state.search" t-on-input="onSearchInput"/>
                    </div>
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" id="vn_stock_group" t-att-checked="state.groupByCategory"
                               t-on-change="onGroupChange"/>
                        <label class="form-check-label small" for="vn_stock_group">Group by Category</label>
                    </div>
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" id="vn_stock_hide_zero" t-att-checked="state.options.hide_zero"
                               t-on-change="onHideZeroChange"/>
                        <label class="form-check-label small" for="vn_stock_hide_zero">Hide Empty Lines</label>
                    </div>
                    <div class="ms-auto d-flex gap-2">
                        <button class="btn btn-sm btn-secondary" t-att-disabled="!state.data or state.exporting" t-on-click="() => this.export('action_export_xlsx')">
                            <i class="fa fa-file-excel-o me-1"/>Export to Excel
                        </button>
                        <button class="btn btn-sm btn-secondary" t-att-disabled="!state.data or state.exporting" t-on-click="() => this.export('action_print_pdf')">
                            <i class="fa fa-file-pdf-o me-1"/>Print PDF
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex-grow-1 overflow-auto px-3 py-3 position-relative">
                <div t-if="state.loading" class="o_vn_loading position-absolute top-0 start-50 translate-middle-x mt-2 badge text-bg-info">
                    <i class="fa fa-circle-o-notch fa-spin me-1"/>Computing...
                </div>
                <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
                <t t-if="state.data">
                    <div class="o_vn_sheet" t-att-class="{ 'opacity-50': state.loading }">
                        <div class="small"><b>Company:</b> <t t-esc="state.data.company"/></div>
                        <div class="text-center my-3">
                            <div class="fs-4 fw-bold">STOCK MOVEMENT SUMMARY</div>
                            <div class="fst-italic" t-esc="state.data.period_text"/>
                            <div class="fst-italic" t-esc="state.data.scope_text"/>
                        </div>
                        <div class="text-end small fst-italic mb-1">Currency: <t t-esc="state.data.currency"/></div>
                        <table class="table table-sm table-bordered table-hover o_vn_table">
                            <thead class="sticky-top bg-view">
                                <tr class="text-center align-middle">
                                    <th rowspan="2" style="width: 3rem;">No.</th>
                                    <th rowspan="2" style="width: 7rem;">Code</th>
                                    <th rowspan="2" class="o_vn_name">Product</th>
                                    <th rowspan="2" style="width: 4rem;">UoM</th>
                                    <th t-foreach="columnGroups" t-as="group" t-key="group.key" t-att-colspan="group.span" t-esc="group.label"/>
                                </tr>
                                <tr class="text-center">
                                    <th t-foreach="columns" t-as="column" t-key="column.key" class="small">
                                        <t t-if="column.kind === 'qty'">Quantity</t>
                                        <t t-else="">Value</t>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row" t-key="row.key">
                                    <tr t-if="row.type === 'group'" class="o_vn_group fw-bold">
                                        <td colspan="4" t-esc="row.label"/>
                                        <t t-foreach="columns" t-as="column" t-key="column.key">
                                            <td class="text-end font-monospace text-nowrap">
                                                <t t-if="column.kind === 'value'" t-esc="format(row.totals[column.key], 'value')"/>
                                            </td>
                                        </t>
                                    </tr>
                                    <tr t-else="" class="o_vn_drillable" title="Click to see the stock moves"
                                        t-on-click="() => this.openLine(row.line)">
                                        <td class="text-center" t-esc="row.line.sequence"/>
                                        <td t-esc="row.line.code"/>
                                        <td class="o_vn_name" t-att-class="{ 'ps-4': state.groupByCategory }" t-esc="row.line.name"/>
                                        <td class="text-center" t-esc="row.line.uom"/>
                                        <t t-foreach="columns" t-as="column" t-key="column.key">
                                            <td class="text-end font-monospace text-nowrap" t-esc="format(row.line[column.key], column.kind)"/>
                                        </t>
                                    </tr>
                                </t>
                                <tr t-if="!rows.length">
                                    <td t-att-colspan="4 + columns.length" class="text-center text-muted fst-italic py-3">No stock movements for these filters.</td>
                                </tr>
                            </tbody>
                            <tfoot t-if="rows.length">
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-center">Total</td>
                                    <t t-foreach="columns" t-as="column" t-key="column.key">
                                        <td class="text-end font-monospace text-nowrap">
                                            <t t-if="column.kind === 'value'" t-esc="format(grandTotals[column.key], 'value')"/>
                                        </td>
                                    </t>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
